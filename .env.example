# Environment variable template — copy to .env and fill in your values
# NEVER commit the real .env file

# ── IBM Watsonx ──────────────────────────────────────────────────────────
# Your IBM Cloud API key (create at cloud.ibm.com/iam/apikeys)
WATSONX_APIKEY=your_ibm_cloud_api_key_here

# Your Watsonx.ai project ID (found in the project settings)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Regional endpoint — change to match your IBM Cloud region:
#   us-south  → https://us-south.ml.cloud.ibm.com
#   eu-de     → https://eu-de.ml.cloud.ibm.com
#   jp-tok    → https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Frontend (Next.js) ───────────────────────────────────────────────────
# URL of the running FastAPI backend (used by the browser, not SSR)
# For local dev keep as-is; for deployment set to your server URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
